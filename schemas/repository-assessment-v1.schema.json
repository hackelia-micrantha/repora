{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/repository-assessment-v1.schema.json",
  "title": "Repora Repository Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "title", "scope", "summary", "snapshot", "findings", "evidence", "scorecard"],
  "properties": {
    "kind": {"const": "repora.repository-assessment"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["quality", "architecture", "sdlc", "security", "operations", "documentation", "evidence"]}
    },
    "summary": {"type": "string", "minLength": 1},
    "snapshot": {"$ref": "repository-snapshot-v1.schema.json"},
    "findings": {"type": "array", "items": {"$ref": "finding-v1.schema.json"}},
    "evidence": {"type": "array", "items": {"$ref": "evidence-v1.schema.json"}},
    "scorecard": {"$ref": "scorecard-v1.schema.json"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
