{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/execution-record-v3.schema.json",
  "title": "Repora execution record v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "execution_id", "phase", "mode", "plan", "repository", "actions"],
  "properties": {
    "version": { "const": 3 },
    "kind": { "const": "repora.io/execution-record" },
    "execution_id": { "$ref": "#/$defs/identifier" },
    "phase": { "enum": ["INTENT", "RESULT"] },
    "mode": { "enum": ["PLAN", "DRY_RUN", "APPLY"] },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "sha256"],
      "properties": {
        "version": { "const": 2 },
        "kind": { "const": "repora.io/reconciliation-plan" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "id"],
      "properties": {
        "uid": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "type", "source", "target", "before", "desired", "force", "outcome"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "type": { "const": "PUSH_BRANCH" },
          "source": { "$ref": "#/$defs/ref" },
          "target": { "$ref": "#/$defs/ref" },
          "before": { "$ref": "#/$defs/oid" },
          "desired": { "$ref": "#/$defs/oid" },
          "after": { "$ref": "#/$defs/oid" },
          "force": { "type": "boolean" },
          "outcome": { "enum": ["PLANNED", "VALIDATED", "APPLIED", "FAILED", "SKIPPED", "STALE"] },
          "error": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^[^/\\s:@?#\\\\]+(?:/[^/\\s:@?#\\\\]+)+$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "path", "remote", "branch"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/path" },
        "remote": { "$ref": "#/$defs/identifier" },
        "branch": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "INTENT" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": { "outcome": { "const": "PLANNED" } },
              "not": { "anyOf": [{ "required": ["after"] }, { "required": ["error"] }] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "RESULT" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "actions": {
            "items": { "properties": { "outcome": { "not": { "const": "PLANNED" } } } }
          }
        }
      }
    }
  ]
}
