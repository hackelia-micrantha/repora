{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/finding-v1.schema.json",
  "title": "Repora Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "type", "severity", "status", "title", "description", "references", "evidence_ids"],
  "properties": {
    "kind": {"const": "repora.finding"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "type": {"enum": ["question", "finding", "recommendation", "tradeoff", "risk", "gap", "overlap", "drift"]},
    "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
    "status": {"enum": ["open", "accepted", "deferred", "implemented", "rejected"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "recommendation": {"type": "string"},
    "tradeoffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owner": {"type": "string"},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["issue", "pull_request", "commit", "file", "url"]},
        "value": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    }
  }
}
