{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/managed-artifact-apply-result-v1.schema.json",
  "title": "Repora managed artifact apply result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "execution_id", "outcome", "repositories", "journal"],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "repora.io/managed-artifact-apply-result"},
    "execution_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "outcome": {"enum": ["APPLIED", "FAILED", "STALE"]},
    "failure_stage": {"enum": ["PREPARE", "PUSH", "STALE"]},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uid", "id", "branch", "base_oid", "pushed", "outcome"],
        "properties": {
          "uid": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "branch": {"type": "string", "minLength": 1},
          "base_oid": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
          "commit_oid": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
          "pushed": {"type": "boolean"},
          "outcome": {"enum": ["APPLIED", "FAILED", "SKIPPED", "STALE"]}
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": {"type": "string", "pattern": "^\\.repora/journal/[A-Za-z0-9._-]+\\.json$"},
        "result": {"type": "string", "pattern": "^\\.repora/journal/[A-Za-z0-9._-]+\\.json$"}
      }
    }
  }
}
