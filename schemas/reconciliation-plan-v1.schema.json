{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/reconciliation-plan-v1.schema.json",
  "title": "Repora reconciliation plan artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "repositories"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "repora.io/reconciliation-plan" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uid", "id", "actions"],
        "properties": {
          "uid": { "$ref": "#/$defs/identifier" },
          "id": { "$ref": "#/$defs/identifier" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "source", "target", "diff", "force", "reason"],
              "properties": {
                "type": { "const": "PUSH_BRANCH" },
                "source": { "$ref": "#/$defs/ref" },
                "target": { "$ref": "#/$defs/ref" },
                "diff": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["observed", "desired"],
                  "properties": {
                    "observed": { "$ref": "#/$defs/oid" },
                    "desired": { "$ref": "#/$defs/oid" }
                  }
                },
                "force": { "type": "boolean" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "remote", "branch"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "remote": { "$ref": "#/$defs/identifier" },
        "branch": { "type": "string", "minLength": 1 }
      }
    }
  }
}
