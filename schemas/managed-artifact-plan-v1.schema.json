{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/managed-artifact-plan-v1.schema.json",
  "title": "Repora managed artifact plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "repositories"],
  "properties": {
    "kind": { "const": "repora.io/managed-artifact-plan" },
    "version": { "const": 1 },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repositoryPlan" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "providerPath": {
      "type": "string",
      "pattern": "^[^\\s\\\\:@?#]+/[^\\s\\\\:@?#]+(?:/[^\\s\\\\:@?#]+)*$",
      "not": { "pattern": "(^|/)(?:\\.|\\.\\.)(?:/|$)" }
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "^/|/$|\\.$|\\.\\.|//|@\\{|[ ~^:?*\\[\\\\]" } },
        { "not": { "pattern": "(^|/)\\." } },
        { "not": { "pattern": "(^|/)[^/]*\\.lock($|/)" } }
      ]
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": ["100644", "100755"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "path", "branch"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/providerPath" },
        "branch": { "$ref": "#/$defs/branch" }
      }
    },
    "observedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "mode": { "$ref": "#/$defs/mode" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "present": { "const": true } }, "required": ["present"] },
          "then": { "required": ["mode", "sha256"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["mode"] },
                { "required": ["sha256"] }
              ]
            }
          }
        }
      ]
    },
    "desiredState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sha256", "content"],
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string", "maxLength": 1048576 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "observed", "desired", "template_sha256", "diff"],
      "properties": {
        "type": { "const": "WRITE_README" },
        "path": { "const": "README.md" },
        "observed": { "$ref": "#/$defs/observedState" },
        "desired": { "$ref": "#/$defs/desiredState" },
        "template_sha256": { "$ref": "#/$defs/sha256" },
        "diff": { "type": "string", "minLength": 1, "maxLength": 4194304 }
      }
    },
    "repositoryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "id", "target", "base_oid", "actions"],
      "properties": {
        "uid": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/target" },
        "base_oid": { "$ref": "#/$defs/oid" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    }
  }
}
