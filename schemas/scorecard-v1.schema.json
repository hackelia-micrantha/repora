{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repora.dev/schemas/scorecard-v1.schema.json",
  "title": "Repora Scorecard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "dimensions"],
  "properties": {
    "kind": {"const": "repora.scorecard"},
    "version": {"const": 1},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dimension"}
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "score", "rationale", "evidence_ids"],
      "properties": {
        "name": {"enum": ["architecture", "security", "testing", "delivery", "operations", "maintainability", "documentation"]},
        "score": {"type": "integer", "minimum": 0, "maximum": 5},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        }
      }
    }
  }
}
