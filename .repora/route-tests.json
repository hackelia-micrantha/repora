{
  "version": 1,
  "kind": "document-route-tests",
  "cases": [
    {
      "name": "overview class loads summary first",
      "query": "Give me a quickstart overview of repoctl",
      "expect_routes": ["summary-docs", "repo-overview"],
      "expect_trust_include": ["generated"],
      "expect_include": ["docs/SUMMARY.md"],
      "expect_budget": {"max_files": 1, "max_bytes": 12000, "max_tokens_hint": 1200}
    },
    {
      "name": "architecture class loads summary then source refinement",
      "query": "Explain planner and executor architecture",
      "expect_routes": ["summary-architecture", "source-plan-go", "architecture-core"],
      "expect_trust_include": ["generated"],
      "expect_include": ["docs/architecture/SUMMARY.md"],
      "expect_budget": {"max_files": 1, "max_bytes": 12000, "max_tokens_hint": 1200}
    },
    {
      "name": "explicit planner source route",
      "query": "Show Reconcile implementation",
      "expect_routes": ["source-plan-go"],
      "expect_include": ["internal/plan/**"],
      "expect_exclude": ["internal/plan/*_test.go"],
      "expect_budget": {"max_files": 4, "max_bytes": 50000, "max_tokens_hint": 5000}
    },
    {
      "name": "explicit command entrypoint source route",
      "query": "Show command entrypoint",
      "expect_routes": ["source-repoctl-command"],
      "expect_include": ["cmd/repoctl/**"],
      "expect_exclude": ["cmd/repoctl/*_test.go"],
      "expect_budget": {"max_files": 4, "max_bytes": 50000, "max_tokens_hint": 5000}
    },
    {
      "name": "policy class",
      "query": "Review the security policy and governance requirements",
      "expect_routes": ["policy-and-governance"],
      "expect_budget": {"max_files": 12, "max_bytes": 140000, "max_tokens_hint": 14000}
    },
    {
      "name": "configuration class loads schema summary first",
      "query": "Show the YAML configuration schema",
      "expect_routes": ["summary-schema", "config-and-schema"],
      "expect_trust_include": ["generated"],
      "expect_include": ["schemas/SUMMARY.md"],
      "expect_budget": {"max_files": 1, "max_bytes": 12000, "max_tokens_hint": 1200}
    },
    {
      "name": "prompts class loads routing summary first",
      "query": "How does the document router reduce token usage?",
      "expect_routes": ["summary-routing", "prompts-and-routing"],
      "expect_trust_include": ["generated"],
      "expect_include": ["docs/routing/SUMMARY.md"],
      "expect_budget": {"max_files": 1, "max_bytes": 12000, "max_tokens_hint": 1200}
    },
    {
      "name": "operations class",
      "query": "Explain the release workflow and CI pipeline",
      "expect_routes": ["operations-and-workflows"],
      "expect_budget": {"max_files": 10, "max_bytes": 100000, "max_tokens_hint": 10000}
    },
    {
      "name": "priority ordering across matches includes summaries first",
      "query": "Review configuration schema architecture and release workflow",
      "expect_routes": ["summary-architecture", "summary-schema", "config-and-schema", "architecture-core", "operations-and-workflows"],
      "expect_trust_include": ["generated"]
    },
    {
      "name": "lexicographic tie break",
      "query": "Review architecture security policy",
      "expect_routes": ["summary-architecture", "architecture-core", "policy-and-governance"],
      "expect_trust_include": ["generated"]
    },
    {
      "name": "explicit docs summary route",
      "query": "Show the documentation summary",
      "expect_routes": ["summary-docs", "repo-overview"],
      "expect_trust_include": ["generated"],
      "expect_include": ["docs/SUMMARY.md"],
      "expect_budget": {"max_files": 1, "max_bytes": 12000, "max_tokens_hint": 1200}
    },
    {
      "name": "fallback docs first",
      "query": "Explain the project in an unrelated phrasing with no route keyword",
      "expect_routes": [],
      "expect_fallback": "docs-first",
      "expect_include": ["README.md", "docs/**", "schemas/**", ".repora/**"],
      "expect_exclude": ["tests/**", "examples/**"],
      "expect_budget": {"max_files": 8, "max_bytes": 100000, "max_tokens_hint": 10000}
    }
  ]
}
