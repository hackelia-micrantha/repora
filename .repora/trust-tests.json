{
  "version": 1,
  "kind": "document-trust-tests",
  "cases": [
    {"name":"canonical root doc","path":"README.md","expect_tier":"canonical","default_eligible":true},
    {"name":"implementation source","path":"internal/plan/plan.go","expect_tier":"implementation","default_eligible":true},
    {"name":"documentation summary is generated","path":"docs/SUMMARY.md","expect_tier":"generated","default_eligible":false},
    {"name":"nested architecture summary is generated","path":"docs/architecture/SUMMARY.md","expect_tier":"generated","default_eligible":false},
    {"name":"schema summary is generated","path":"schemas/SUMMARY.md","expect_tier":"generated","default_eligible":false},
    {"name":"explicit summary inclusion","path":"docs/routing/SUMMARY.md","expect_tier":"generated","explicit_include":["generated"],"default_eligible":false,"explicit_eligible":true},
    {"name":"archived doc overrides broad docs rule","path":"docs/archive/legacy.md","expect_tier":"archived","default_eligible":false},
    {"name":"generated output","path":"artifacts/security/licenses.csv","expect_tier":"generated","default_eligible":false},
    {"name":"experimental draft","path":"drafts/new-policy.md","expect_tier":"experimental","default_eligible":false},
    {"name":"external source","path":"vendor/example/module.go","expect_tier":"external","default_eligible":false},
    {"name":"unclassified path fails closed","path":"misc/notes.txt","expect_tier":"unclassified","default_eligible":false},
    {"name":"explicit archived inclusion","path":"docs/archive/legacy.md","expect_tier":"archived","explicit_include":["archived"],"default_eligible":false,"explicit_eligible":true},
    {"name":"explicit inclusion does not change tier","path":"vendor/example/module.go","expect_tier":"external","explicit_include":["external"],"default_eligible":false,"explicit_eligible":true}
  ]
}
